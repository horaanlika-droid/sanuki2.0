# ─────────────────────────────────────────────────────────────
# SANUKI — минимальная конфигурация (для хостинга достаточно этих трёх строк)
# ─────────────────────────────────────────────────────────────

# Токен Telegram-бота (@BotFather)
BOT_TOKEN=

# Telegram ID администратора. Можно несколько через запятую: 123,456
ADMIN_ID=

# Токен ЮMoney. Пока оплата работает в режиме заглушки (YOOMONEY_MODE=stub),
# значение не проверяется — достаточно любого непустого значения.
YOOMONEY_API=

# ─────────────────────────────────────────────────────────────
# Необязательные параметры
# ─────────────────────────────────────────────────────────────

# stub (по умолчанию) — оплата имитируется; live — реальные запросы к ЮMoney
# YOOMONEY_MODE=stub
# Номер кошелька для приёма платежей
# YOOMONEY_WALLET=4100111111111111
# Секрет для проверки HTTP-уведомлений ЮMoney (обязателен в live)
# YOOMONEY_SECRET=

# Публичный адрес приложения. Если задан — в боте появляется кнопка
# «Открыть SANUKI» (Telegram Web App). Например: https://sanuki.example.com
# WEBAPP_URL=

# Порт веб-сервера (по умолчанию 8000)
# PORT=8000

# Путь к файлу базы данных (по умолчанию data/sanuki.db)
# DB_PATH=data/sanuki.db

# Режим отладки: включает dev-вход без Telegram. В продакшене — 0.
# DEBUG=0

# Если хостинг работает только через вебхуки, укажите внешний адрес:
# WEBHOOK_URL=https://sanuki.example.com
