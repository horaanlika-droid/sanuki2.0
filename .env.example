# ==== SANUKI 2.0 — настройка на BotHost ====
# Достаточно трёх переменных, больше ничего не нужно:

# 1) Токен бота из @BotFather
BOT_TOKEN=

# 2) ID администратора (можно несколько через запятую)
ADMIN_ID=

# 3) API-ключ ЮMoney (пока интеграция не готова — можно оставить пустым,
#    оплата работает через встроенную заглушку)
YOOMONEY_API=

# ---- Опционально ----
# Публичный https-адрес веб-приложения (для кнопок «Открыть на сайте» в боте).
# WEB_BASE_URL=
# Порт веб-приложения
# WEB_PORT=8000
